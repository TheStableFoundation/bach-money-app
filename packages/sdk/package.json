{
  "name": "@bach-money/sdk",
  "version": "0.1.0",
  "private": false,
  "description": "TypeScript client SDK for the Bach Money on-chain program",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "dev": "tsc --project tsconfig.build.json --watch",
    "lint": "tsc --noEmit"
  },
  "peerDependencies": {
    "@solana/web3.js": "^1.x"
  },
  "devDependencies": {
    "@solana/web3.js": "^1.98.2",
    "typescript": "^5.9.3"
  }
}
