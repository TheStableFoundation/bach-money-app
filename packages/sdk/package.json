{
  "name": "@bach-money/sdk",
  "version": "0.1.0",
  "private": false,
  "description": "TypeScript client SDK for the Bach Money on-chain program",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "dev": "tsc --project tsconfig.build.json --watch",
    "lint": "tsc --noEmit"
  },
  "peerDependencies": {
    "@solana/web3.js": "^1.x"
  },
  "devDependencies": {
    "@solana/web3.js": "^1.98.2",
    "@types/node": "^20.19.26",
    "typescript": "^5.9.3"
  }
}
